# ============================================================
# THE NEXUS CORE - Configuration Template
#
# Copy this file to .env and fill in your values.
# .env is gitignored and will never be committed to version control.
#
#   cp .env.example .env
# ============================================================


# --------------------------
# DATA STORAGE
# Where Nexus Core stores conversations, indices, memory, and personas.
# Defaults to ./nexus_data (relative to where you run the program).
# Use an absolute path to store data outside the project folder.
# --------------------------
NEXUS_DATA_PATH=./nexus_data


# --------------------------
# LLM PROVIDER
#
# Options:
#   none       - Run without real inference. All modules work but
#                responses are stubs. Good for testing structure.
#   openai     - Requires OPENAI_API_KEY
#   anthropic  - Requires ANTHROPIC_API_KEY
#   ollama     - Local models, no key required. Needs Ollama installed
#                and running (https://ollama.com)
# --------------------------
LLM_PROVIDER=none


# OpenAI
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Anthropic
# Get your key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=

# Ollama (local, no key required)
# Only change this if Ollama is running on a different host or port.
OLLAMA_BASE_URL=http://localhost:11434


# Model to use - must match your chosen provider.
#
# OpenAI examples:
#   gpt-4o              (best quality)
#   gpt-4o-mini         (faster, cheaper)
#   gpt-3.5-turbo       (legacy, cheapest)
#
# Anthropic examples:
#   claude-3-5-sonnet-20241022   (best balance)
#   claude-3-haiku-20240307      (fastest, cheapest)
#
# Ollama examples (must be pulled first with `ollama pull <model>`):
#   llama3.2
#   mistral
#   phi3
#   gemma2
LLM_MODEL=

# Generation settings
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048


# --------------------------
# RAG PARAMETERS
# --------------------------

# How many results to return from search queries
SEARCH_TOP_K=5

# Maximum tokens to keep in a conversation context window
# before compression kicks in
CONTEXT_MAX_TOKENS=4096

# Similarity threshold for deduplication (0.0-1.0)
# Higher = stricter, fewer results removed
DEDUP_SIMILARITY_THRESHOLD=0.85

# Similarity threshold for detecting a topic change in threads (0.0-1.0)
# Lower = more sensitive to topic changes
TOPIC_CHANGE_THRESHOLD=0.5


# --------------------------
# QUALITY THRESHOLDS
# Scores used to label search results as High / Medium / Low quality.
# Results below QUALITY_LOW_THRESHOLD are labeled Poor.
# --------------------------
QUALITY_HIGH_THRESHOLD=0.8
QUALITY_MED_THRESHOLD=0.6
QUALITY_LOW_THRESHOLD=0.4


# --------------------------
# BRAIN-LIKE AI
# --------------------------

# Maximum recursion depth for iterative refinement
RECURSIVE_MAX_DEPTH=3

# Quality score (0.0-1.0) at which recursive refinement stops early
RECURSIVE_REFLECTION_THRESHOLD=0.8

# Short-term memory capacity (number of items)
MEMORY_STM_CAPACITY=20

# How long short-term memory items live before natural decay (minutes)
MEMORY_STM_RETENTION_MINUTES=30


# --------------------------
# LOGGING
# Options: DEBUG | INFO | WARNING | ERROR | CRITICAL
# --------------------------
LOG_LEVEL=INFO
